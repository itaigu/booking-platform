# Copy these from Supabase: Project Settings → API Keys (and Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: only needed to add staff from the dashboard. Never share it.
SUPABASE_SECRET_KEY=sb_secret_...
